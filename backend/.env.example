# AIDoc 后端环境变量配置

# ==============================
# 数据库配置
# ==============================

# PostgreSQL 数据库连接地址
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aidoc

# ==============================
# 前端/后端地址
# ==============================

# 前端地址（用于 CORS 配置）
FRONTEND_URL=http://localhost:3000

# 后端地址
BACKEND_URL=http://localhost:8000

# ==============================
# LLM 服务配置（智谱 AI GLM-5.1）
# ==============================

# 智谱 AI API Key
LLM_API_KEY=your_zhipuai_api_key_here

# LLM 服务地址
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 使用的 LLM 模型名
LLM_MODEL=glm-5.1

# ==============================
# Redis 配置（可选）
# ==============================

# Redis 地址（可选，不配置则不使用 Redis）
REDIS_URL=

# ==============================
# 文件存储配置
# ==============================

# 文件存储类型: local / s3 / oss
FILE_STORAGE_TYPE=local

# 本地文件存储路径（当 FILE_STORAGE_TYPE=local 时使用）
LOCAL_STORAGE_PATH=./storage

# S3 bucket 名称（当 FILE_STORAGE_TYPE=s3 时使用）
S3_BUCKET=

# S3 Access Key（当 FILE_STORAGE_TYPE=s3 时使用）
S3_ACCESS_KEY=

# S3 Secret Key（当 FILE_STORAGE_TYPE=s3 时使用）
S3_SECRET_KEY=

# ==============================
# 代码执行配置
# ==============================

# 代码执行模式: pyodide / backend
# pyodide: 前端执行（推荐，适合 Demo）
# backend: 后端执行（需要沙箱环境）
CODE_EXECUTION_MODE=pyodide

# 代码执行超时时间（秒）
CODE_EXECUTION_TIMEOUT=30

# ==============================
# 日志配置
# ==============================

# 日志等级: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
